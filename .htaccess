# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/catalincocos/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/catalincocos/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# ── http:// și www. → https://catalincocos.ro (o singură adresă) ─
# .well-known/ rămâne neatins, ca reînnoirea SSL (AutoSSL) să meargă.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://catalincocos.ro%{REQUEST_URI} [R=301,L]
</IfModule>

# ── /index.html → / (canonical, o singură adresă) ──────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
</IfModule>

# ── Cache policy ────────────────────────────────────────────────
# HTML + JSON data: always revalidate, so content updates are seen
# immediately (no stale pages after a deploy or an admin edit).
# CSS/JS: cache-busted with ?v=<hash> in the markup, so cache hard.
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs|woff2?|ttf|otf|eot|jpe?g|png|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
